# Chép file này thành .env rồi điền. KHÔNG gửi .env cho ai, KHÔNG đưa vào gói giao.
# Lấy key Gemini: https://aistudio.google.com -> Get API key
GEMINI_API_KEY=
# Tuỳ chọn, cho chế độ chia sẻ (bash tools/web.sh share): đặt mã (ít nhất 6 ký tự) thì /app bắt nhập mã;
# để trống thì ai có link cũng vào được.
DUBBER_ACCESS_CODE=
